    <ComponentPart id="d269d616-f910-4b14-a849-8d596ae65585">
      <AllFieldElementsRequired>false</AllFieldElementsRequired>
      <FilterCode><![CDATA[using System.Linq;
using System.Collections.Generic;
using SwissAcademic.Citavi;
using SwissAcademic.Citavi.Metadata;
using SwissAcademic.Collections;
using SwissAcademic.Drawing;

namespace SwissAcademic.Citavi.Citations
{
	public class ComponentPartFilter
		:
		IComponentPartFilter
	{
		public IEnumerable<ITextUnit> GetTextUnits(ComponentPart componentPart, Template template, Citation citation, out bool handled)
		{
			//return handled = true if this macro generates the output (as a IEnumerable<ITextUnit>); the standard output will be suppressed
			//return handled = false if you want Citavi to produce the standard output; 
			//you can still manipulate the component part and its elements before letting Citavi generate the output with handled = false
			handled = false;
			
			if (citation == null) return null;
			Reference thisReference = citation.Reference;
			if (thisReference == null) return null;
			
			
			if (citation.CitationManager == null) return null;
			
			var thisIndex = GetCitationIndex(citation);
			
			handled = true;
			var output = new TextUnitCollection();
			var indexOutput = new LiteralTextUnit(thisIndex);
			output.Add(indexOutput);
			return output;

				
			

		}
		
		string GetCitationIndex(Citation thisCitation)
		{
			//0 = regular Index
			//P0 = Literatruverzeichnis_eigeneVeröffentlichungen
			//S0 = Literaturverzeichnis_studentischeArbeiten
			if (thisCitation == null) return "0";
			
			Reference thisReference = thisCitation.Reference;
			if (thisReference == null) return "0";
			
			CitationManager citationManager = thisCitation.CitationManager;
			if (citationManager == null) return "0";
			
			if (citationManager.BibliographyCitations == null || !citationManager.BibliographyCitations.Any() || !citationManager.BibliographyCitations.IsSorted) return "0";
			
		
			string thisIndexGroup = GetIndexGroup(thisCitation);
			string currentIndexGroup = "";
			int counter = 0;
			
			
			foreach(BibliographyCitation otherCitation in citationManager.BibliographyCitations)
			{
				string otherIndexGroup = GetIndexGroup(otherCitation);
				if (!otherIndexGroup.Equals(currentIndexGroup))
				{
					currentIndexGroup = otherIndexGroup;
					counter = 0;
				}
				if (currentIndexGroup.Equals(thisIndexGroup)) counter++;
				if (otherCitation.Reference == thisReference) return string.Format("{0}{1}", thisIndexGroup, counter);
			}
			
			//still here? nothing found
			return "0";
		}
		
		string GetIndexGroup(Citation thisCitation)
		{
			// = regular Index
			//P = Literatruverzeichnis_eigeneVeröffentlichungen
			//S = Literaturverzeichnis_studentischeArbeiten
			if (thisCitation == null) return "";
			
			Reference thisReference = thisCitation.Reference;

			if (thisReference == null || thisReference.Groups == null || !thisReference.Groups.Any()) return "";
			if (thisReference.Groups.Any(item => item.Name.Equals("Literaturverzeichnis_eigeneVeröffentlichungen")))
			{
				return "P";
			}
			else if (thisReference.Groups.Any(item => item.Name.Equals("Literaturverzeichnis_studentischeArbeiten")))
			{
				return "S";
			}
			
			return "";
		}
	}
}]]></FilterCode>
