    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.0007"/>
    </inertial>
  </link>
  <joint name="Wrist_Joint_x" type="revolute">
    <parent link="Endeffektor_y"/>
    <child link="Endeffektor_x"/>
    <axis xyz="0 1 0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <limit effort="10.0" lower="-0.8" upper="0.8" velocity="0.5"/>
    <dynamics damping="0.01" friction="0.04"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint>
  <link name="Mesh_Endeffektor">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Endeffektor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Endeffektor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000175" ixy="0.0" ixz="0.0" iyy="0.000175" iyz="0.0" izz="0.0000614"/>
    </inertial>
  </link>
  <joint name="fixed_Wrist_Mesh" type="fixed">
    <origin rpy="3.14 0 2.616" xyz="0 0 -0.0033"/>
