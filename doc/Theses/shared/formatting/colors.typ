// FAPS Color Palette
// ============================================================
// Official colors from FAPS PowerPoint style guide (2022)

// ── Green family ─────────────────────────────────────────────
#let faps-gruen-dunkel  = rgb(106, 138, 34)   // FAPS-Grün dunkel
#let faps-gruen         = rgb(151, 193, 57)   // FAPS-Grün (primary)
#let faps-gruen-hell    = rgb(197, 222, 137)  // FAPS-Grün hell
#let gruen-dunkel       = rgb(63, 95, 68)     // Grün dunkel
#let hausfarbe-gruen    = rgb(101, 141, 103)  // Hausfarbe Grün
#let gruen-hell         = rgb(97, 192, 134)   // Grün hell

// ── Teal family ──────────────────────────────────────────────
#let tuertkis-dunkel    = rgb(0, 67, 89)      // Türkis dunkel
#let hausfarbe-tuertkis = rgb(52, 103, 125)   // Hausfarbe Türkis
#let tf-metallic        = rgb(119, 159, 181)  // TF Metallic

// ── Blue family ──────────────────────────────────────────────
#let fau-blau-dunkel    = rgb(4, 30, 66)      // FAU-Blau dunkel
#let fau-blau           = rgb(0, 47, 108)     // FAU-Blau
#let fau-blau-hell      = rgb(108, 140, 199)  // FAU-Blau hell

// ── Gray family ──────────────────────────────────────────────
#let grau-1             = rgb(149, 162, 171)  // Grau 1
#let grau-2             = rgb(176, 188, 196)  // Grau 2
#let grau-3             = rgb(209, 217, 222)  // Grau 3

// ── Special / accent colors ───────────────────────────────────
#let sonderfa-gelb      = rgb(255, 203, 0)    // Sonderfarbe Gelb
#let sonderfa-orange    = rgb(245, 130, 31)   // Sonderfarbe Orange
#let sonderfa-echtrot   = rgb(220, 30, 38)    // Sonderfarbe Echtrot

// ── Legacy aliases ────────────────────────────────────────────
#let fapsgruen      = faps-gruen             // #97C139 — primary accent, list bullets
#let fapsblau       = rgb(41, 97, 147)       // #296193 — headings, links (legacy value kept)
#let fapsgraudunkel = rgb(95, 95, 95)        // #5F5F5F — diagram edges, secondary text
#let dunkelgrau     = grau-2                 // Grau 2 — borders, rules
#let hellgrau       = grau-3                 // Grau 3 — table header backgrounds
#let mittelgrau     = grau-1                 // Grau 1 — medium gray
