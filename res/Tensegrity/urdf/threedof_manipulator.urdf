<?xml version="1.0" ?>

<robot name="threedof_manipulator">

  <link name="root_link">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
    <!-- no <visual>, no <collision> -->
  </link>

  <joint name="root_upper_arm_fixed_joint" type="fixed">
    <origin rpy="1.57 1.57 0" xyz="-0.0225 0.007 -0.10244"/>
    <parent link="root_link"/>
    <child link="upper_arm_link"/>
  </joint>

  <link name="upper_arm_link">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.1333" iyz="0.0" izz="0.001333"/>
    </inertial>
  </link>

  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="cylinder_approx_link"/>
    <axis xyz="0 0 1"/>
    <origin rpy="1.57 0 0" xyz="0.352 0.0226 0"/> <!--0.352 0.0226 0.007-->
    <limit effort="0.125" lower="-1.5" upper="1.5" velocity="1.0"/>
    <!--1.45-->
    <dynamics damping="0.0036" friction="0.002"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint>

  <link name="cylinder_approx_link">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.192"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001536" iyz="0.0" izz="0.0001536"/>
    </inertial>
  </link>

  <joint name="cylinder_forearm_fixed_joint" type="fixed">
    <origin rpy="1.57 3.14 -1.57" xyz="0.193 0 0"/>
    <parent link="cylinder_approx_link"/>
    <child link="forearm_link"/>
  </joint>

  <link name="forearm_link">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.9"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.07286" ixy="0.0" ixz="0.0" iyy="0.01099" iyz="0.0" izz="0.0104"/>
    </inertial>
  </link>

  <fixed_frame name="imu1_frame">
    <parent link="forearm_link"/>
    <origin rpy="0 0 3.14" xyz="0 0.03 -0.148"/>
  </fixed_frame>

   <joint name="wrist_y_joint" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_y_link"/>
    <axis xyz="1 0 0"/>
    <origin rpy="0 0 3.14" xyz="0 0 -0.241"/>
    <limit effort="10.0" lower="-0.8" upper="0.8" velocity="0.5"/>
    <dynamics damping="0.01" friction="0.04"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint> 

  <link name="wrist_y_link">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>

  <joint name="wrist_x_joint" type="revolute">
    <parent link="wrist_y_link"/>
    <child link="wrist_x_link"/>
    <axis xyz="0 1 0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <limit effort="10.0" lower="-0.8" upper="0.8" velocity="0.5"/>
    <dynamics damping="0.01" friction="0.04"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint>  

  <link name="wrist_x_link">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
  </link>

  <joint name="wrist_mesh_fixed_joint" type="fixed">
    <origin rpy="3.14 0 2.616" xyz="0 0 -0.0033"/>
    <parent link="wrist_x_link"/>
    <child link="end_effector_link"/>
  </joint>  

  <link name="end_effector_link">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Endeffektor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Endeffektor.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.4"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.000175" ixy="0.0" ixz="0.0" 
               iyy="0.000175" iyz="0.0" 
               izz="0.0000614"/>
    </inertial>
  </link>

  <fixed_frame name="imu2_frame">
    <parent link="end_effector_link"/>
    <origin rpy="3.14 0 2.6172" xyz="0 0 0.09"/>
  </fixed_frame>

  <joint name="ee_tool_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.11768"/>
    <parent link="end_effector_link"/>
    <child link="tool_link"/>
  </joint>  

  <link name="tool_link">
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0"
               iyy="1e-6" iyz="0"
               izz="1e-6"/>
    </inertial>
    <!-- no <visual>, no <collision> -->
  </link>

</robot>

