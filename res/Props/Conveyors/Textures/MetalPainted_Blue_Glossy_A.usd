#usda 1.0
(
    defaultPrim = "Material"
    doc = "Stub material resolving ConveyorBelt_A06.usd's missing MetalPainted_Blue_Glossy_A reference."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Shader.outputs:surface>

    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.10, 0.22, 0.60)
        float inputs:metallic = 0.8
        float inputs:roughness = 0.2
        token outputs:surface
    }
}
