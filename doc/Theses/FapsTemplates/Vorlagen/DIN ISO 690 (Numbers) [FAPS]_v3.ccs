      <Notes />
      <PunctuationAfter type="LiteralElement">
        <ApplyCondition>Always</ApplyCondition>
        <FontStyle behavior="SameAsPrevious" />
        <Text />
      </PunctuationAfter>
      <PunctuationBefore type="LiteralElement">
