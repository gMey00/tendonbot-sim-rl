<?xml version="1.0" ?>

<robot name="threedof_manipulator">

  <link name="world"/>

  <joint name="Rahmen_Oberarm" type="fixed">
    <origin rpy="1.57 1.57 0" xyz="-0.0225 0.007 -0.10244"/>
    <parent link="world"/>
    <child link="Oberarm"/>
  </joint>
  <link name="Oberarm">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.1333" iyz="0.0" izz="0.001333"/>
    </inertial>
  </link>
  <joint name="Joint1" type="revolute">
    <parent link="Oberarm"/>
    <child link="Unterarm"/>
    <axis xyz="0 0 1"/>
    <origin rpy="1.57 0 0" xyz="0.352 0.0226 0"/>
    <limit effort="0.125" lower="-1.5" upper="1.5" velocity="1.0"/>
    <!--1.45-->
    <dynamics damping="0.0036" friction="0.002"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint>
  <link name="Unterarm">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.192"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001536" iyz="0.0" izz="0.0001536"/>
    </inertial>
  </link>
  <joint name="cylinder1_Unterarm" type="fixed">
    <origin rpy="1.57 3.14 -1.57" xyz="0.193 0 0"/>
    <parent link="Unterarm"/>
    <child link="Mesh_Unterarm"/>
  </joint>
  <link name="Mesh_Unterarm">
    <visual>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="/home/robot/studentische-arbeiten/res/Tensegrity/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.9"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.07286" ixy="0.0" ixz="0.0" iyy="0.01099" iyz="0.0" izz="0.0104"/>
    </inertial>
  </link>

  <link name="Endeffektor_x">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.001333" iyz="0.0" izz="0.00002267"/>
    </inertial>
  </link>
  <joint name="Wrist_Joint_y" type="revolute">
    <parent link="Mesh_Unterarm"/>
    <child link="Endeffektor_y"/>
    <axis xyz="1 0 0"/>
    <origin rpy="0 0 3.14" xyz="0 0 -0.241"/>
    <limit effort="10.0" lower="-0.8" upper="0.8" velocity="0.5"/>
    <dynamics damping="0.01" friction="0.04"/>
    <!-- damping="0.0036" friction="0.002"-->
  </joint>
  <link name="Endeffektor_y">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
