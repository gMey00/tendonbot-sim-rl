flowchart TB
    Step["env.step(actions)"]

    subgraph Managers["Manager-Based MDP Decomposition"]
        direction LR
        Act["Action<br/>Manager"]
        Obs["Observation<br/>Manager"]
        Rew["Reward<br/>Manager"]
        Term["Termination<br/>Manager"]
        Event["Event<br/>Manager"]
        Curr["Curriculum<br/>Manager"]
    end

    Step --> Act
    Act -- "apply actions" --> Sim["Physics Step<br/><i>PhysX</i>"]
    Sim --> Obs
    Sim --> Rew
    Sim --> Term
    Sim --> Event
    Event --> Curr

    Obs -- "o_t" --> Out["Policy Input"]
    Rew -- "r_t" --> Out
    Term -- "done" --> Out

    style Step fill:#296193,color:#FFFFFF,stroke:#1E4F6E
    style Sim fill:#97C139,color:#2B2B2B,stroke:#5F5F5F
    style Out fill:#296193,color:#FFFFFF,stroke:#1E4F6E
    style Act fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Obs fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Rew fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Term fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Event fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Curr fill:#D6E8A8,color:#2B2B2B,stroke:#5F5F5F
    style Managers fill:#F2F2F2,stroke:#5F5F5F,color:#296193
