<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="threedof_manipulator">

  <xacro:include filename="colors.urdf.xacro" />
  

  <link name="world"></link>
   
  <joint name="base_joint" type="fixed">
  	<origin xyz="0 0 0.02" rpy="0 0 -1.57"/>
        	<parent link="world"/>
        	<child link="base_link"/>        
  </joint>  
  
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Rahmen.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Rahmen.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="4"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.1333" iyz="0.0" izz="0.001333"/>
    </inertial>
  </link> 

  <joint name="Rahmen_Oberarm" type="fixed">
  	<origin xyz="-0.024538 0.652315 1.717584" rpy="1.57 1.57 0"/>
        	<parent link="base_link"/>
        	<child link="Oberarm"/>        
  </joint>  

  <link name="Oberarm">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Oberarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.1333" iyz="0.0" izz="0.001333"/>
    </inertial>
  </link> 

  <joint name="Joint1" type="revolute">
    <parent link="Oberarm"/>
    <child link="Unterarm"/>
    <axis xyz="0 0 1"/>
    <origin xyz="0.352 0.0226 0" rpy="1.57 0 0"/>
    <limit effort="0.125" velocity="1.0" lower="-1.5" upper="1.5"/> <!--1.45-->
    <dynamics damping="0.0036" friction="0.002"/> <!-- damping="0.0036" friction="0.002"-->
  </joint> 

  <link name="Unterarm">
    <visual>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.083"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.192"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001536" iyz="0.0" izz="0.0001536"/>
    </inertial>
  </link>

  <joint name="cylinder1_Unterarm" type="fixed">
  	<origin xyz="0.193 0 0" rpy="1.57 3.14 -1.57"/>
        	<parent link="Unterarm"/>
        	<child link="Mesh_Unterarm"/>        
  </joint> 

  <link name="Mesh_Unterarm">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 0.9"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robot_description/meshes/Unterarm_Simulation.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.9"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.07286" ixy="0.0" ixz="0.0" iyy="0.01099" iyz="0.0" izz="0.0104"/>
    </inertial>
  </link>

  <joint name="Force1_Unterarm" type="revolute">
    <parent link="Mesh_Unterarm"/>
    <child link="Force1"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0.0725 0 0.1" rpy="-1.57 3.14 0" passive="true"/>
    <limit effort="10.0" velocity="1.0" lower="0.1" upper="0.1"/>
    <passive/>
  </joint> 

  <link name="Force1">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.001333" iyz="0.0" izz="0.00002267"/>
    </inertial>
  </link>

  <joint name="Force2_Unterarm" type="revolute">
    <parent link="Mesh_Unterarm"/>
    <child link="Force2"/>
    <axis xyz="0 1 0"/>
    <origin xyz="-0.0725 0 0.1" rpy="1.57 0 0"/>
    <limit effort="10.0" velocity="1.0" lower="-0.01" upper="0.01"/>
  </joint> 

  <link name="Force2">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.01"/>
