#usda 1.0
(
    defaultPrim = "Material"
    doc = "Stub material resolving ConveyorBelt_A06.usd's missing M_ConveyorBelt_A01_Decal reference."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Shader.outputs:surface>

    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.85, 0.85, 0.88)
        float inputs:metallic = 0.0
        float inputs:roughness = 0.5
        token outputs:surface
    }
}
