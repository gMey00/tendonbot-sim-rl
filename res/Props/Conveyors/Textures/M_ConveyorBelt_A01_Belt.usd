#usda 1.0
(
    defaultPrim = "Material"
    doc = "Stub material resolving ConveyorBelt_A06.usd's missing M_ConveyorBelt_A01_Belt reference."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Shader.outputs:surface>

    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.10, 0.10, 0.11)
        float inputs:metallic = 0.0
        float inputs:roughness = 0.7
        token outputs:surface
    }
}
