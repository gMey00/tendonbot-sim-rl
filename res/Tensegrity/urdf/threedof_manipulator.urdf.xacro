      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.001333" iyz="0.0" izz="0.00002267"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="revolute">
    <parent link="Mesh_Unterarm"/>
    <child link="IMU"/>
    <axis xyz="0 0 0"/>
    <origin xyz="0 0.03 -0.148" rpy="0 0 3.14"/>
    <limit effort="10.0" velocity="0" lower="0" upper="0"/>
  </joint> 

  <link name="IMU">
    <visual>
      <geometry>
        <sphere radius="0.01"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.001333" iyz="0.0" izz="0.00002267"/>
    </inertial>
  </link>

  <link name="Endeffektor_x">
    <visual>
      <geometry>
        <sphere  radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.001333" ixy="0.0" ixz="0.0" iyy="0.001333" iyz="0.0" izz="0.00002267"/>
    </inertial>
  </link>

  <joint name="Wrist_Joint_y" type="revolute">
    <parent link="Mesh_Unterarm"/>
    <child link="Endeffektor_y"/>
    <axis xyz="1 0 0"/>
    <origin xyz="0 0 -0.241" rpy="0 0 3.14"/>
    <limit effort="10.0" velocity="0.5" lower="-0.8" upper="0.8"/>
    <dynamics damping="0.01" friction="0.04"/> <!-- damping="0.0036" friction="0.002"-->
  </joint> 

  <link name="Endeffektor_y">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.0001"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.0007"/>
    </inertial>
  </link>

  <joint name="Wrist_Joint_x" type="revolute">
    <parent link="Endeffektor_y"/>
    <child link="Endeffektor_x"/>
    <axis xyz="0 1 0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <limit effort="10.0" velocity="0.5" lower="-0.8" upper="0.8"/>
    <dynamics damping="0.01" friction="0.04"/> <!-- damping="0.0036" friction="0.002"-->
  </joint> 

  <link name="Mesh_Endeffektor">
