#usda 1.0
(
    defaultPrim = "Material"
    doc = "Stub material resolving ConveyorBelt_A06.usd's missing Steel_A reference."
)

def Material "Material"
{
    token outputs:surface.connect = </Material/Shader.outputs:surface>

    def Shader "Shader"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
        float inputs:metallic = 1.0
        float inputs:roughness = 0.35
        token outputs:surface
    }
}
